/*
  PEGAR DENTRO de:
  service cloud.firestore { match /databases/{database}/documents { ... } }

  Este bloque reutiliza funciones que YA existen en EI ERP Nova V6.2:
  activeUser(), isAdminOrSuper(), isManager(), isQualityRole().
  No reemplaza reglas de cases/orders/inventario.
*/

match /erpQaTracker/{projectId} {
  allow read: if activeUser();
  allow create, update: if activeUser() && (isAdminOrSuper() || isManager() || isQualityRole());
  allow delete: if isAdminOrSuper() || isManager();
}

match /erpQaPublic/{projectId} {
  // Resumen sanitizado para compartir con el superior sin login.
  allow read: if true;
  allow create, update: if activeUser() && (isAdminOrSuper() || isManager() || isQualityRole());
  allow delete: if isAdminOrSuper() || isManager();
}
